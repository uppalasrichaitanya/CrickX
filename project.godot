; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CrickX"
config/description="The Ultimate Cricket Experience - Professional 2D Cricket Game"
boot_splash/bg_color=Color(0.051, 0.067, 0.09, 1)
boot_splash/show_image=false
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Constants="*res://autoloads/Constants.gd"
GameManager="*res://autoloads/GameManager.gd"
MatchEngine="*res://autoloads/MatchEngine.gd"
AudioManager="*res://autoloads/AudioManager.gd"
SaveManager="*res://autoloads/SaveManager.gd"
NetworkManager="*res://autoloads/NetworkManager.gd"
CommentaryManager="*res://autoloads/CommentaryManager.gd"
TournamentManager="*res://autoloads/TournamentManager.gd"
CareerManager="*res://autoloads/CareerManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://CrickXTheme.tres"

